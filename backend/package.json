{
  "name": "floodsense-backend",
  "version": "2.0.0",
  "description": "FloodSense Kinshasa — Operational Flood Risk Management Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/config/initDb.js",
    "db:seed": "node src/config/seedDb.js",
    "db:doctor": "node src/config/dbDoctor.js",
    "db:reset": "node src/config/resetDb.js",
    "check:syntax": "find src -name \"*.js\" -print0 | xargs -0 -I{} node -c {} && node -c server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "africastalking": "^0.6.2",
    "nodemailer": "^6.9.7",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.6.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}